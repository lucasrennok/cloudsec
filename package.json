    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{js,css,html,json,md}": "prettier --write"
  }
